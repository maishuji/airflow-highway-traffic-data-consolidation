# Copy this file to .env before starting the Compose environment.
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.6
AIRFLOW_PROJ_DIR=.
AIRFLOW_UID=50000
AIRFLOW_API_PORT=8080
AIRFLOW_API_AUTH_JWT_SECRET=local-development-jwt-secret-change-me

# Airflow 3's simple auth manager generates the password on first start and
# prints it in the API server logs. Change the username before sharing.
AIRFLOW_ADMIN_USERNAME=airflow

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Generate a Fernet key for a shared environment; blank is acceptable locally.
AIRFLOW_FERNET_KEY=
